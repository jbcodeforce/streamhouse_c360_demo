# AWS Region (must match IaC/AWS)
aws_region_primary = "us-west-2"
environment        = "demo"
project_name       = "c360"

# Existing EC2 key pair used for SSH
key_pair_name = "my-keypair"

# Who may reach HTTP (80) and SSH (22). Never use 0.0.0.0/0 (rejected by validation).
allowed_cidr_blocks = ["203.0.113.10/32"]

# Public HTTPS repo cloned onto the instance, and the ref to deploy
repo_url = "https://github.com/<org>/streamhouse_c360_demo.git"
repo_ref = "main"

# Optional
# subnet_id        = "subnet-0..."
# instance_type    = "t3.medium"
# root_volume_size = 30
