#!/bin/bash
# Rendered by Terraform (IaC/EC2/ec2.tf). Output: /var/log/cloud-init-output.log
set -euxo pipefail

dnf install -y docker git
systemctl enable --now docker

# Docker Compose + Buildx CLI plugins (pinned, SHA-256 verified).
PLUGIN_DIR=/usr/local/lib/docker/cli-plugins
mkdir -p "$PLUGIN_DIR"

curl -fsSL -o "$PLUGIN_DIR/docker-compose" \
  https://github.com/docker/compose/releases/download/v5.7.0/docker-compose-linux-x86_64
echo "7758048ad38e580f22559603312874fec8bb638d021a9e64182385fc17cc12a2  $PLUGIN_DIR/docker-compose" | sha256sum -c -

curl -fsSL -o "$PLUGIN_DIR/docker-buildx" \
  https://github.com/docker/buildx/releases/download/v0.38.2/buildx-v0.38.2.linux-amd64
echo "7992ec09413b80ff57ba4e081f56fc833d7bac1d5e71143c6c809e7e6065f6d6  $PLUGIN_DIR/docker-buildx" | sha256sum -c -

chmod 755 "$PLUGIN_DIR/docker-compose" "$PLUGIN_DIR/docker-buildx"

# Deploy settings (no secrets: only names/ARNs; values are read at deploy time
# through the instance role).
cat > /etc/c360-deploy.env <<'EOF'
REPO_URL=${repo_url}
REPO_REF=${repo_ref}
AWS_REGION=${aws_region}
RDS_SECRET_ARN=${rds_secret_arn}
APP_SECRET_ID=${app_secret_id}
EOF
chmod 600 /etc/c360-deploy.env

echo '${deploy_script_b64}' | base64 -d > /usr/local/bin/c360-deploy
chmod 755 /usr/local/bin/c360-deploy

# First deploy. It exits early (without failing boot) until the app secret has a
# value; once it does, run `sudo c360-deploy` over SSH/SSM.
/usr/local/bin/c360-deploy || echo "c360-deploy did not complete; fix the cause above and re-run: sudo c360-deploy"
